# ---- Python 虚拟环境 ----
# 注意：WSL 里建的 venv 含 Linux 符号链接，Windows 端 git 读不了，千万别提交
.venv/
venv/
env/
ENV/

# ---- Python 缓存 / 构建产物 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ---- 数据 / 模型权重（大文件不进 git）----
data/
datasets/
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 训练日志 ----
runs/
wandb/
*.log
